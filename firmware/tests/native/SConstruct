import os

native_toolchain = os.environ.get(
    "NATIVE_TOOLCHAIN_PATH",
    r"C:\Program Files\JetBrains\CLion 2026.1.3\bin\mingw\bin",
)
native_gcc = os.path.join(native_toolchain, "gcc.exe")

if not os.path.isfile(native_gcc):
    raise RuntimeError(f"Native GCC not found: {native_gcc}")

env = Environment(
    tools=["mingw"],
    ENV=os.environ,
)
env.PrependENVPath("PATH", native_toolchain)
env.Replace(CC="gcc", LINK="gcc")
env.Append(CCFLAGS=["-Wall", "-Wextra"])
env.Append(CPPPATH=[
    "include",
    "../../app",
    "../../app/acquisition",
    "../../app/pipeline",
    "../../app/event",
    "../../app/storage",
    "../../app/diagnostics",
    "../../app/ota",
    "../../app/runtime",
    "../../app/reliability",
    "../../app/health",
    "../../app/environment",
    "../../app/reset_power",
    "../../app/time",
    "../../app/transport",
    "../../app/ai_inference",
    "../../app/power",
    "../../config",
    "../../drivers/icm45686",
    "../../drivers/sht4x",
    "../../components/storage",
    "../../components/protocol",
    "../../components/ota",
    "../../bsp/weact_h743",
])

